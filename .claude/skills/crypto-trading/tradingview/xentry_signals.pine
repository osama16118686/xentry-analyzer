// Xentry Signals — مناطق الشراء والبيع مع وقف الخسارة والهدف وإدارة المخاطرة
//
// الإشارة لا تظهر إلا إذا اتفقت كل الشروط على إغلاق الشمعة (لا تُعاد رسمها):
//   شراء: EMA50 فوق EMA200 والسعر فوق EMA200، وقوة الاتجاه ADX فوق الحد،
//         وRSI يقطع 40 للأعلى (نهاية التصحيح)، وهستوجرام MACD يرتفع، وشمعة خضراء
//   بيع:  العكس (RSI يقطع 60 للأسفل)
// الوقف = 1.5 × ATR والهدف = 3 × ATR من سعر الدخول، وحجم الصفقة يُحسب من نسبة المخاطرة.
//
// نفس المنطق موجود في scripts/backtest.py (استراتيجية confluence). نتائجه على بيانات
// Binance الحقيقية في references/backtest_results.md: قريبة من التعادل بعد العمولات،
// أي أنه أداة لتنظيم الدخول والوقف وليس آلة أرباح. اختبره في Strategy Tester قبل أي استخدام.

//@version=6
strategy("Xentry Signals", shorttitle = "Xentry", overlay = true, initial_capital = 1000,
     commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 2,
     pyramiding = 0, max_labels_count = 500, max_lines_count = 500)

// ── الإعدادات
grpR = "إدارة المخاطرة"
riskPct = input.float(1.0, "المخاطرة لكل صفقة %", minval = 0.1, maxval = 5, step = 0.1, group = grpR)
stopAtr = input.float(1.5, "وقف الخسارة (× ATR)", minval = 0.5, step = 0.1, group = grpR)
tgtAtr  = input.float(3.0, "الهدف (× ATR)", minval = 0.5, step = 0.1, group = grpR)

grpS = "الإشارات"
adxMin     = input.int(20, "أقل قوة اتجاه ADX", minval = 0, group = grpS)
rsiLong    = input.int(40, "RSI يقطع للأعلى (شراء)", group = grpS)
rsiShort   = input.int(60, "RSI يقطع للأسفل (بيع)", group = grpS)
allowShort = input.bool(true, "السماح بصفقات البيع (Short)", group = grpS)

grpV = "العرض"
showZones  = input.bool(true, "تلوين مناطق الاتجاه", group = grpV)
showLevels = input.bool(true, "رسم الوقف والهدف", group = grpV)
showPanel  = input.bool(true, "لوحة المؤشرات", group = grpV)

// ── المؤشرات
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi    = ta.rsi(close, 14)
[macdLine, macdSig, hist] = ta.macd(close, 12, 26, 9)
[diPlus, diMinus, adx] = ta.dmi(14, 14)
atr    = ta.atr(14)

// Computed every bar on their own lines: and/or are lazy in Pine v6
rsiUpCross = ta.crossover(rsi, rsiLong)
rsiDnCross = ta.crossunder(rsi, rsiShort)
macdUp     = hist > hist[1]

upTrend   = ema50 > ema200 and close > ema200
downTrend = ema50 < ema200 and close < ema200
trending  = adx > adxMin

longSig  = upTrend and trending and rsiUpCross and macdUp and close > open
shortSig = allowShort and downTrend and trending and rsiDnCross and not macdUp and close < open

// ── الدخول والخروج
flat     = strategy.position_size == 0
stopDist = stopAtr * atr
tgtDist  = tgtAtr * atr
qty      = math.min(strategy.equity * riskPct / 100 / stopDist, strategy.equity / close)

if flat and longSig
    strategy.entry("L", strategy.long, qty = qty)
    strategy.exit("XL", from_entry = "L", loss = stopDist / syminfo.mintick, profit = tgtDist / syminfo.mintick)
    sl = close - stopDist
    tp = close + tgtDist
    if showLevels
        line.new(bar_index, sl, bar_index + 20, sl, color = color.red, style = line.style_dashed)
        line.new(bar_index, tp, bar_index + 20, tp, color = color.green, style = line.style_dashed)
    label.new(bar_index, low, "شراء\nوقف " + str.tostring(sl, format.mintick) + "\nهدف " + str.tostring(tp, format.mintick),
         style = label.style_label_up, color = color.green, textcolor = color.white, size = size.small)
    alert("Xentry شراء " + syminfo.ticker + " | دخول≈" + str.tostring(close, format.mintick) +
         " وقف " + str.tostring(sl, format.mintick) + " هدف " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

if flat and shortSig and not longSig
    strategy.entry("S", strategy.short, qty = qty)
    strategy.exit("XS", from_entry = "S", loss = stopDist / syminfo.mintick, profit = tgtDist / syminfo.mintick)
    sl = close + stopDist
    tp = close - tgtDist
    if showLevels
        line.new(bar_index, sl, bar_index + 20, sl, color = color.red, style = line.style_dashed)
        line.new(bar_index, tp, bar_index + 20, tp, color = color.green, style = line.style_dashed)
    label.new(bar_index, high, "بيع\nوقف " + str.tostring(sl, format.mintick) + "\nهدف " + str.tostring(tp, format.mintick),
         style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)
    alert("Xentry بيع " + syminfo.ticker + " | دخول≈" + str.tostring(close, format.mintick) +
         " وقف " + str.tostring(sl, format.mintick) + " هدف " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

// ── الرسم
plot(ema20, "EMA 20", color = color.new(color.yellow, 40))
plot(ema50, "EMA 50", color = color.orange, linewidth = 2)
plot(ema200, "EMA 200", color = color.blue, linewidth = 2)
bgcolor(showZones and trending and upTrend ? color.new(color.green, 92) :
     showZones and trending and downTrend ? color.new(color.red, 92) : na, title = "منطقة الاتجاه")

// ── لوحة المؤشرات
var table panel = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 20), border_width = 1)
if showPanel and barstate.islast
    trendTxt = upTrend ? "صاعد" : downTrend ? "هابط" : "محايد"
    trendCol = upTrend ? color.green : downTrend ? color.red : color.gray
    posTxt = strategy.position_size > 0 ? "في صفقة شراء" : strategy.position_size < 0 ? "في صفقة بيع" : "انتظر إشارة"
    table.cell(panel, 0, 0, "الاتجاه", text_color = color.white)
    table.cell(panel, 1, 0, trendTxt, text_color = color.white, bgcolor = trendCol)
    table.cell(panel, 0, 1, "قوة الاتجاه ADX", text_color = color.white)
    table.cell(panel, 1, 1, str.tostring(adx, "#.0") + (trending ? "" : " (عرضي)"), text_color = trending ? color.white : color.orange)
    table.cell(panel, 0, 2, "RSI", text_color = color.white)
    table.cell(panel, 1, 2, str.tostring(rsi, "#.0"), text_color = rsi > 70 ? color.red : rsi < 30 ? color.lime : color.white)
    table.cell(panel, 0, 3, "MACD", text_color = color.white)
    table.cell(panel, 1, 3, macdUp ? "يتحسن" : "يضعف", text_color = macdUp ? color.lime : color.red)
    table.cell(panel, 0, 4, "التذبذب ATR", text_color = color.white)
    table.cell(panel, 1, 4, str.tostring(atr / close * 100, "#.00") + "%", text_color = color.white)
    table.cell(panel, 0, 5, "الحالة", text_color = color.white)
    table.cell(panel, 1, 5, posTxt, text_color = color.yellow)
